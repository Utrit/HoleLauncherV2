<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HoleLauncher.App">
    <Application.Resources>
        <FontFamily x:Key="SnProMedium">avares://HoleLauncher/Assets/Fonts/SNPro-Medium.ttf#Sn Pro Medium</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://HoleLauncher/Assets/Fonts/SNPro-Medium.ttf#Sn Pro Medium</FontFamily>
        <FontFamily x:Key="SnProSemiBold">avares://HoleLauncher/Assets/Fonts/SNPro-SemiBold.ttf#Sn Pro SemiBold</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button"><Setter Property="FontFamily" Value="{StaticResource SnProSemiBold}" /></Style>
    </Application.Styles>
</Application>
